# ---------------------------------------------------------------------------
# Copy to .env (development) or .env.test (tests) and fill in real values.
# Never commit the real files - they are git-ignored.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Swagger UI at /docs (disable in production if the API must not be self-describing)
SWAGGER_ENABLED=true

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=pos_dev
DB_SSL=false
DB_LOGGING=false
# Run pending migrations automatically on boot (used by the Docker image)
DB_RUN_MIGRATIONS=false

# --- Auth ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h

# --- Redis (product catalogue cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# --- Payments ---
PAYMENT_PROVIDER=mock
# Hard timeout for a provider call; on timeout the sale stays PENDING_PAYMENT for reconciliation
PAYMENT_TIMEOUT_MS=5000
# Artificial latency of the mock provider (useful to demo concurrency)
MOCK_PAYMENT_LATENCY_MS=0
# Sales stuck in PENDING_PAYMENT longer than this are reconciled by a background job
SALE_RECONCILE_AFTER_SECONDS=120
SALE_RECONCILE_ENABLED=true
