    {
      "name": "Sales",
      "item": [
        {
          "name": "Create sale (payment succeeds)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stores/{{acmeDowntownStoreId}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{acmeDowntownStoreId}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{acmeEspressoId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{acmeCroissantId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"payment\": {\n    \"method\": \"CARD\",\n    \"token\": \"tok_visa\"\n  }\n}"
            },
            "description": "A new Idempotency-Key is generated before each send. Expect 201 COMPLETED."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300 || pm.response.code === 402) {",
                  "  pm.collectionVariables.set('saleId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry last sale (same key, replayed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stores/{{acmeDowntownStoreId}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{acmeDowntownStoreId}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{acmeEspressoId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{acmeCroissantId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"payment\": {\n    \"method\": \"CARD\",\n    \"token\": \"tok_visa\"\n  }\n}"
            },
            "description": "Reuses the key of the previous request. Returns the original response with header Idempotent-Replayed: true. Change the body and you get 409 IDEMPOTENCY_KEY_REUSED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create sale (card declined)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stores/{{acmeDowntownStoreId}}/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stores",
                "{{acmeDowntownStoreId}}",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
