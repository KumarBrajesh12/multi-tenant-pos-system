    {
      "name": "Tenant admin (onboarding flow)",
      "description": "Run top to bottom: platform admin onboards a merchant, the owner accepts the invitation, opens a store and invites a cashier, who then accepts. Tokens and ids are carried over in collection variables.",
      "item": [
        {
          "name": "Login - Platform admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@platform.test\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Stores the access token in the `token` collection variable used by every other request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "List all merchants (platform)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
