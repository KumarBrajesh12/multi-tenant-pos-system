              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "platform",
                "merchants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Corner Bakery\",\n  \"slug\": \"{{newMerchantSlug}}\",\n  \"currency\": \"USD\",\n  \"ownerEmail\": \"owner+{{newMerchantSlug}}@cornerbakery.test\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newMerchantSlug', 'corner-bakery-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('newMerchantId', body.id);",
                  "pm.collectionVariables.set('inviteToken', body.ownerInvitation.inviteToken);"
                ]
              }
            }
          ]
        },
