# Used by Jest (NODE_ENV=test). Copy to .env.test and adjust credentials.
# Tests TRUNCATE tables, so always point this at a dedicated database.
NODE_ENV=test
PORT=3001
SWAGGER_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=pos_test
DB_SSL=false
DB_LOGGING=false
DB_RUN_MIGRATIONS=true
JWT_SECRET=test-only-secret-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=15m
# How long an invitation link stays valid (hours)
INVITATION_TTL_HOURS=168
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=15
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
PAYMENT_PROVIDER=mock
PAYMENT_TIMEOUT_MS=2000
MOCK_PAYMENT_LATENCY_MS=0
SALE_RECONCILE_AFTER_SECONDS=120
SALE_RECONCILE_ENABLED=false
